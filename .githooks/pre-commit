#!/usr/bin/env bash
# Pre-commit hook: delegate to the pre-commit framework
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Avoid cp1252 stdout warnings from Python-based hooks on Windows.
export PYTHONIOENCODING=UTF-8

if [ ! -f "$repo_root/.pre-commit-config.yaml" ]; then
	echo "ERROR: .pre-commit-config.yaml not found at repo root." >&2
	exit 1
fi

if command -v pre-commit >/dev/null 2>&1; then
	pre-commit run --hook-stage pre-commit
	exit $?
fi

if command -v pre_commit >/dev/null 2>&1; then
	pre_commit run --hook-stage pre-commit
	exit $?
fi

if command -v python >/dev/null 2>&1; then
	python -m pre_commit run --hook-stage pre-commit
	exit $?
fi

if command -v python3 >/dev/null 2>&1; then
	python3 -m pre_commit run --hook-stage pre-commit
	exit $?
fi

if command -v py >/dev/null 2>&1; then
	py -m pre_commit run --hook-stage pre-commit
	exit $?
fi

if command -v py.exe >/dev/null 2>&1; then
	py.exe -m pre_commit run --hook-stage pre-commit
	exit $?
fi

# Fallback for Windows environments where python/py are not on PATH
# but Python is installed in the default per-user location.
for p in /c/Users/*/AppData/Local/Programs/Python/Python*/python.exe; do
	if [ -x "$p" ]; then
		"$p" -m pre_commit run --hook-stage pre-commit
		exit $?
	fi
done

echo "ERROR: pre-commit is required but not installed or not on PATH." >&2
echo "Install with: py -m pip install --user pre-commit" >&2
exit 1
